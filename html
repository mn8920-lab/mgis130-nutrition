              <div class="fact-cell"><span class="fact-lbl">Fiber</span><span class="fact-val">${formatApiCell(fibInfo, mult, "g")}</span></div>
              <div class="fact-cell"><span class="fact-lbl">Sugar</span><span class="fact-val">${formatApiCell(sugInfo, mult, "g")}</span></div>
              <div class="fact-cell"><span class="fact-lbl">Sodium</span><span class="fact-val">${formatApiCell(sodInfo, mult, "mg", true)}</span></div>
              <div class="fact-cell"><span class="fact-lbl">Potassium</span><span class="fact-val">${formatApiCell(potInfo, mult, "mg", true)}</span></div>
              <div class="fact-cell"><span class="fact-lbl">Cholesterol</span><span class="fact-val">${formatApiCell(cholInfo, mult, "mg", true)}</span></div>
            </div>
            <div class="api-item-footer">
