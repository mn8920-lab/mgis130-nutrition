      function updateNutrientBar(labelEl, barEl, current, target, unit = "g", isWhole = false) {
        const curFormatted = isWhole ? Math.round(current).toLocaleString() : round1(current);
        const tgtFormatted = isWhole ? Math.round(target).toLocaleString() : target;
