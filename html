              </label>
              <button type="button" class="btn btn-primary log-single-api-btn" style="padding:0.38rem 0.75rem; font-size:0.8rem;">
                + Add
              </button>
            </div>
          `;

          const qtyInput = card.querySelector("input");
          qtyInput.addEventListener("change", (e) => {
            item._multiplier = Math.max(0.1, parseFloat(e.target.value) || 1);
