<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Nutrition Check — Daily Macro & Calorie Tracker</title>
  <style>
    /* ==========================================================================
       CSS VARIABLES & THEME TOKENS
       ========================================================================== */
    :root {
      --bg-app: #f4f7f6;
      --bg-card: #ffffff;
      --bg-subtle: #f8faf9;
      --bg-hover: #eef3f1;
      --text-main: #18231f;
      --text-muted: #5b6e67;
      --text-light: #879892;
      --border-color: #e2e9e6;
      --primary: #10b981;
      --primary-dark: #059669;
      --primary-light: #d1fae5;
      --accent-protein: #3b82f6;
      --accent-carbs: #f59e0b;
      --accent-fat: #ef4444;
      --accent-fiber: #8b5cf6;
      --accent-sugar: #ec4899;
      --shadow-sm: 0 1px 3px rgba(16, 35, 28, 0.05);
      --shadow-md: 0 6px 16px rgba(16, 35, 28, 0.08);
      --radius-sm: 8px;
      --radius-md: 14px;
      --radius-lg: 20px;
      --font-sans: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      --transition: all 0.2s cubic-bezier(0.25, 0.8, 0.25, 1);
    }

    @media (prefers-color-scheme: dark) {
      :root {
        --bg-app: #0e1513;
        --bg-card: #16201d;
        --bg-subtle: #1c2824;
        --bg-hover: #24332e;
        --text-main: #edf4f1;
        --text-muted: #9eb0a9;
        --text-light: #6d8079;
        --border-color: #263631;
        --primary: #10b981;
        --primary-dark: #34d399;
        --primary-light: rgba(16, 185, 129, 0.16);
        --shadow-sm: 0 2px 4px rgba(0, 0, 0, 0.25);
        --shadow-md: 0 8px 20px rgba(0, 0, 0, 0.35);
      }
    }

    /* ==========================================================================
       RESET & BASE STYLES
       ========================================================================== */
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: var(--font-sans);
      background-color: var(--bg-app);
      color: var(--text-main);
      line-height: 1.5;
      -webkit-font-smoothing: antialiased;
      min-height: 100vh;
    }

    button, input, select {
      font-family: inherit;
      font-size: 0.95rem;
      color: inherit;
    }

    button {
      cursor: pointer;
      border: none;
      background: none;
    }

    /* ==========================================================================
       HEADER & NAVIGATION
       ========================================================================== */
    header {
      background-color: var(--bg-card);
      border-bottom: 1px solid var(--border-color);
      position: sticky;
      top: 0;
      z-index: 50;
      box-shadow: var(--shadow-sm);
    }

    .header-inner {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0.9rem 1.25rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      flex-wrap: wrap;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 0.65rem;
    }

    .brand-icon {
      width: 38px;
      height: 38px;
      border-radius: 10px;
      background: linear-gradient(135deg, var(--primary), #047857);
      display: flex;
      align-items: center;
      justify-content: center;
      color: #fff;
      font-weight: 800;
      font-size: 1.15rem;
      box-shadow: 0 4px 10px rgba(16, 185, 129, 0.3);
    }

    .brand-title {
      font-size: 1.25rem;
      font-weight: 700;
      letter-spacing: -0.02em;
    }

    .brand-sub {
      font-size: 0.78rem;
      color: var(--text-muted);
      display: block;
    }

    .header-actions {
      display: flex;
      align-items: center;
      gap: 0.65rem;
    }

    .date-badge {
      background: var(--bg-subtle);
      border: 1px solid var(--border-color);
      padding: 0.45rem 0.85rem;
      border-radius: var(--radius-sm);
      font-size: 0.85rem;
      font-weight: 600;
      color: var(--text-muted);
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.45rem;
      padding: 0.55rem 1rem;
      border-radius: var(--radius-sm);
      font-weight: 600;
      font-size: 0.88rem;
      transition: var(--transition);
    }

    .btn-primary {
      background-color: var(--primary);
      color: #ffffff;
    }

    .btn-primary:hover {
      background-color: var(--primary-dark);
      transform: translateY(-1px);
    }

    .btn-outline {
      background-color: var(--bg-card);
      border: 1px solid var(--border-color);
      color: var(--text-main);
    }

    .btn-outline:hover {
      background-color: var(--bg-hover);
    }

    .btn-danger-soft {
      background-color: rgba(239, 68, 68, 0.1);
      color: #ef4444;
    }

    .btn-danger-soft:hover {
      background-color: rgba(239, 68, 68, 0.18);
    }

    /* ==========================================================================
       MAIN LAYOUT GRID
       ========================================================================== */
    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 1.5rem 1.25rem 3rem;
      display: grid;
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    @media (min-width: 960px) {
      .container {
        grid-template-columns: 420px 1fr;
        align-items: start;
      }
    }

    .card {
      background-color: var(--bg-card);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-md);
      padding: 1.35rem;
      box-shadow: var(--shadow-sm);
    }

    .card-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 1.15rem;
    }

    .card-title {
      font-size: 1.05rem;
      font-weight: 700;
      letter-spacing: -0.01em;
    }

    /* ==========================================================================
       DAILY SUMMARY & SVG CALORIE RING
       ========================================================================== */
    .summary-stack {
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }

    .calorie-hero {
      display: flex;
      align-items: center;
      justify-content: space-around;
      gap: 1.25rem;
      padding: 0.5rem 0;
      flex-wrap: wrap;
    }

    .ring-wrapper {
      position: relative;
      width: 168px;
      height: 168px;
      flex-shrink: 0;
    }

    .ring-svg {
      width: 100%;
      height: 100%;
      transform: rotate(-90deg);
    }

    .ring-bg {
      fill: none;
      stroke: var(--bg-hover);
      stroke-width: 14;
    }

    .ring-progress {
      fill: none;
      stroke: var(--primary);
      stroke-width: 14;
      stroke-linecap: round;
      transition: stroke-dashoffset 0.6s cubic-bezier(0.22, 1, 0.36, 1), stroke 0.3s ease;
    }

    .ring-progress.over-limit {
      stroke: var(--accent-fat);
    }

    .ring-center {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
    }

    .ring-kcal-val {
      font-size: 1.65rem;
      font-weight: 800;
      line-height: 1.1;
      letter-spacing: -0.02em;
    }

    .ring-kcal-label {
      font-size: 0.78rem;
      color: var(--text-muted);
      font-weight: 600;
      margin-top: 2px;
    }

    .calorie-stats {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      min-width: 140px;
    }

    .stat-row {
      display: flex;
      flex-direction: column;
    }

    .stat-label {
      font-size: 0.78rem;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.04em;
      font-weight: 600;
    }

    .stat-value {
      font-size: 1.15rem;
      font-weight: 700;
    }

    .stat-value.positive {
      color: var(--primary);
    }

    .stat-value.negative {
      color: var(--accent-fat);
    }

    /* ==========================================================================
       MACRO BREAKDOWN VISUALIZATION & PROGRESS BARS
       ========================================================================== */
    .macro-split-bar {
      height: 12px;
      width: 100%;
      background-color: var(--bg-hover);
      border-radius: 999px;
      overflow: hidden;
      display: flex;
      margin: 0.75rem 0 1.25rem;
    }

    .split-seg {
      height: 100%;
      transition: width 0.5s ease;
    }

    .seg-protein { background-color: var(--accent-protein); }
    .seg-carbs { background-color: var(--accent-carbs); }
    .seg-fat { background-color: var(--accent-fat); }

    .macro-legend {
      display: flex;
      justify-content: space-between;
      font-size: 0.78rem;
      color: var(--text-muted);
      margin-bottom: 1.15rem;
      padding-bottom: 0.9rem;
      border-bottom: 1px solid var(--border-color);
    }

    .legend-item {
      display: flex;
      align-items: center;
      gap: 0.35rem;
      font-weight: 600;
    }

    .dot {
      width: 9px;
      height: 9px;
      border-radius: 50%;
    }

    .nutrient-bars {
      display: flex;
      flex-direction: column;
      gap: 0.95rem;
    }

    .nutrient-item-head {
      display: flex;
      justify-content: space-between;
      font-size: 0.85rem;
      margin-bottom: 0.35rem;
    }

    .nutrient-name {
      font-weight: 600;
    }

    .nutrient-nums {
      color: var(--text-muted);
      font-variant-numeric: tabular-nums;
    }

    .progress-track {
      width: 100%;
      height: 8px;
      background-color: var(--bg-hover);
      border-radius: 999px;
      overflow: hidden;
    }

    .progress-fill {
      height: 100%;
      border-radius: 999px;
      transition: width 0.45s cubic-bezier(0.22, 1, 0.36, 1);
    }

    /* ==========================================================================
       FOOD SEARCH, CUSTOMIZER & CUSTOM FOOD CREATOR
       ========================================================================== */
    .food-finder {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .tabs {
      display: flex;
      background-color: var(--bg-subtle);
      padding: 4px;
      border-radius: var(--radius-sm);
      border: 1px solid var(--border-color);
    }

    .tab-btn {
      flex: 1;
      padding: 0.5rem;
      border-radius: 6px;
      font-size: 0.85rem;
      font-weight: 600;
      color: var(--text-muted);
      transition: var(--transition);
    }

    .tab-btn.active {
      background-color: var(--bg-card);
      color: var(--text-main);
      box-shadow: var(--shadow-sm);
    }

    .search-box {
      position: relative;
    }

    .input-field {
      width: 100%;
      padding: 0.65rem 0.9rem;
      border-radius: var(--radius-sm);
      border: 1px solid var(--border-color);
      background-color: var(--bg-subtle);
      transition: var(--transition);
    }

    .input-field:focus {
      outline: none;
      border-color: var(--primary);
      background-color: var(--bg-card);
      box-shadow: 0 0 0 3px var(--primary-light);
    }

    .food-list {
      max-height: 250px;
      overflow-y: auto;
      display: flex;
      flex-direction: column;
      gap: 0.45rem;
      padding-right: 2px;
    }

    .food-option {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0.65rem 0.85rem;
      border-radius: var(--radius-sm);
      border: 1px solid var(--border-color);
      background-color: var(--bg-subtle);
      cursor: pointer;
      transition: var(--transition);
      text-align: left;
    }

    .food-option:hover {
      border-color: var(--primary);
      background-color: var(--bg-hover);
    }

    .food-option.selected {
      border-color: var(--primary);
      background-color: var(--primary-light);
    }

    .food-opt-title {
      font-weight: 600;
      font-size: 0.9rem;
      display: block;
    }

    .food-opt-meta {
      font-size: 0.78rem;
      color: var(--text-muted);
    }

    .food-opt-cal {
      font-weight: 700;
      font-size: 0.88rem;
      color: var(--primary-dark);
      white-space: nowrap;
      margin-left: 0.5rem;
    }

    /* Selected Food Serving Panel */
    .serving-panel {
      background-color: var(--bg-subtle);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-sm);
      padding: 1rem;
      display: flex;
      flex-direction: column;
      gap: 0.85rem;
    }

    .serving-controls {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.75rem;
    }

    .form-group {
      display: flex;
      flex-direction: column;
      gap: 0.3rem;
    }

    .form-label {
      font-size: 0.78rem;
      font-weight: 600;
      color: var(--text-muted);
    }

    .preview-pills {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
    }

    .pill {
      font-size: 0.76rem;
      font-weight: 600;
      padding: 0.25rem 0.55rem;
      border-radius: 6px;
      background-color: var(--bg-card);
      border: 1px solid var(--border-color);
    }

    /* Custom Food Form Grid */
    .custom-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 0.75rem;
    }

    .custom-grid .full-span {
      grid-column: span 2;
    }

    /* ==========================================================================
       MEAL LOGS SECTION
       ========================================================================== */
    .meals-column {
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
    }

    .meal-card {
      background-color: var(--bg-card);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-md);
      overflow: hidden;
      box-shadow: var(--shadow-sm);
    }

    .meal-header {
      padding: 1rem 1.25rem;
      background-color: var(--bg-subtle);
      border-bottom: 1px solid var(--border-color);
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .meal-title-wrap {
      display: flex;
      align-items: center;
      gap: 0.6rem;
    }

    .meal-icon {
      font-size: 1.2rem;
    }

    .meal-name {
      font-weight: 700;
      font-size: 1rem;
    }

    .meal-cals {
      font-weight: 700;
      font-size: 0.9rem;
      color: var(--primary-dark);
      background-color: var(--primary-light);
      padding: 0.25rem 0.65rem;
      border-radius: 999px;
    }

    .meal-items {
      padding: 0.5rem 1.25rem;
    }

    .meal-empty {
      padding: 1.15rem 0;
      text-align: center;
      color: var(--text-light);
      font-size: 0.86rem;
    }

    .logged-item {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
      padding: 0.75rem 0;
      border-bottom: 1px solid var(--border-color);
    }

    .logged-item:last-child {
      border-bottom: none;
    }

    .logged-info {
      flex: 1;
      min-width: 0;
    }

    .logged-name {
      font-weight: 600;
      font-size: 0.92rem;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .logged-macros {
      font-size: 0.78rem;
      color: var(--text-muted);
      margin-top: 2px;
    }

    .logged-right {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }

    .logged-kcal {
      font-weight: 700;
      font-size: 0.9rem;
      white-space: nowrap;
    }

    .btn-remove {
      width: 28px;
      height: 28px;
      border-radius: 6px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--text-light);
      transition: var(--transition);
    }

    .btn-remove:hover {
      background-color: rgba(239, 68, 68, 0.12);
      color: #ef4444;
    }

    /* ==========================================================================
       MODAL (CUSTOMIZE DAILY GOALS)
       ========================================================================== */
    .modal-backdrop {
      position: fixed;
      inset: 0;
      background-color: rgba(10, 20, 16, 0.55);
      backdrop-filter: blur(3px);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1rem;
      z-index: 100;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.2s ease;
    }

    .modal-backdrop.open {
      opacity: 1;
      pointer-events: auto;
    }

    .modal-box {
      background-color: var(--bg-card);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-md);
      width: 100%;
      max-width: 440px;
      padding: 1.5rem;
      box-shadow: var(--shadow-md);
      transform: translateY(10px);
      transition: transform 0.2s ease;
    }

    .modal-backdrop.open .modal-box {
      transform: translateY(0);
    }

    .modal-footer {
      display: flex;
      justify-content: flex-end;
      gap: 0.65rem;
      margin-top: 1.25rem;
    }

    /* ==========================================================================
       TOAST NOTIFICATION
       ========================================================================== */
    .toast {
      position: fixed;
      bottom: 1.25rem;
      right: 1.25rem;
      background-color: var(--text-main);
      color: var(--bg-card);
      padding: 0.7rem 1.1rem;
      border-radius: var(--radius-sm);
      font-size: 0.86rem;
      font-weight: 600;
      box-shadow: var(--shadow-md);
      transform: translateY(120%);
      opacity: 0;
      transition: all 0.25s ease;
      z-index: 200;
    }

    .toast.show {
      transform: translateY(0);
      opacity: 1;
    }

    .hidden {
      display: none !important;
    }
  </style>
</head>
<body>

  <!-- ========================================================================
       HEADER
       ======================================================================== -->
  <header>
    <div class="header-inner">
      <div class="brand">
        <div class="brand-icon" aria-hidden="true">NC</div>
        <div>
          <span class="brand-title">Nutrition Check</span>
          <span class="brand-sub">Daily Macro &amp; Calorie Tracker</span>
        </div>
      </div>
      <div class="header-actions">
        <span id="current-date" class="date-badge">Today</span>
        <button id="open-goals-btn" class="btn btn-outline" type="button">Edit Goals</button>
        <button id="reset-day-btn" class="btn btn-danger-soft" type="button">Clear Log</button>
      </div>
    </div>
  </header>

  <!-- ========================================================================
       MAIN CONTENT
       ======================================================================== -->
  <main class="container">
    <!-- LEFT COLUMN: DAILY TRACKER & FOOD INPUT -->
    <section class="summary-stack">
      <!-- Daily Progress Card -->
      <div class="card">
        <div class="card-header">
          <h2 class="card-title">Daily Nutrition Summary</h2>
          <span id="goal-badge" style="font-size: 0.8rem; color: var(--text-muted); font-weight: 600;">Goal: 2,000 kcal</span>
        </div>

        <!-- SVG Calorie Ring -->
        <div class="calorie-hero">
          <div class="ring-wrapper">
            <svg class="ring-svg" viewBox="0 0 160 160">
              <circle class="ring-bg" cx="80" cy="80" r="66"></circle>
              <circle id="calorie-ring-progress" class="ring-progress" cx="80" cy="80" r="66"
                stroke-dasharray="414.69" stroke-dashoffset="414.69"></circle>
            </svg>
            <div class="ring-center">
              <span id="ring-consumed" class="ring-kcal-val">0</span>
              <span class="ring-kcal-label">kcal eaten</span>
            </div>
          </div>

          <div class="calorie-stats">
            <div class="stat-row">
              <span class="stat-label">Daily Goal</span>
              <span id="stat-goal" class="stat-value">2,000 kcal</span>
            </div>
            <div class="stat-row">
              <span id="stat-rem-label" class="stat-label">Remaining</span>
              <span id="stat-remaining" class="stat-value positive">2,000 kcal</span>
            </div>
          </div>
        </div>

        <!-- Caloric Macro Split Bar -->
        <div>
          <div style="display:flex; justify-content:space-between; font-size:0.78rem; color:var(--text-muted); font-weight:600; margin-top:0.5rem;">
            <span>Macro Energy Split</span>
            <span id="macro-pct-summary">0% P · 0% C · 0% F</span>
          </div>
          <div class="macro-split-bar" title="Macro calorie distribution">
            <div id="split-protein" class="split-seg seg-protein" style="width: 0%;"></div>
            <div id="split-carbs" class="split-seg seg-carbs" style="width: 0%;"></div>
            <div id="split-fat" class="split-seg seg-fat" style="width: 0%;"></div>
          </div>
          <div class="macro-legend">
            <span class="legend-item"><span class="dot" style="background:var(--accent-protein)"></span>Protein</span>
            <span class="legend-item"><span class="dot" style="background:var(--accent-carbs)"></span>Carbs</span>
            <span class="legend-item"><span class="dot" style="background:var(--accent-fat)"></span>Fat</span>
          </div>
        </div>

        <!-- Detailed Nutrient Progress Bars -->
        <div class="nutrient-bars">
          <!-- Protein -->
          <div>
            <div class="nutrient-item-head">
              <span class="nutrient-name">Protein</span>
              <span id="val-protein" class="nutrient-nums">0 / 150 g</span>
            </div>
            <div class="progress-track">
              <div id="bar-protein" class="progress-fill" style="width:0%; background:var(--accent-protein);"></div>
            </div>
          </div>

          <!-- Carbs -->
          <div>
            <div class="nutrient-item-head">
              <span class="nutrient-name">Carbohydrates</span>
              <span id="val-carbs" class="nutrient-nums">0 / 225 g</span>
            </div>
            <div class="progress-track">
              <div id="bar-carbs" class="progress-fill" style="width:0%; background:var(--accent-carbs);"></div>
            </div>
          </div>

          <!-- Fat -->
          <div>
            <div class="nutrient-item-head">
              <span class="nutrient-name">Fat</span>
              <span id="val-fat" class="nutrient-nums">0 / 65 g</span>
            </div>
            <div class="progress-track">
              <div id="bar-fat" class="progress-fill" style="width:0%; background:var(--accent-fat);"></div>
            </div>
          </div>

          <!-- Fiber -->
          <div>
            <div class="nutrient-item-head">
              <span class="nutrient-name">Dietary Fiber</span>
              <span id="val-fiber" class="nutrient-nums">0 / 30 g</span>
            </div>
            <div class="progress-track">
