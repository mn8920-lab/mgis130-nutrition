  <!-- ========================================================================
       VANILLA JAVASCRIPT APPLICATION LOGIC
       ======================================================================== -->
  <script>
    (function () {
      "use strict";

      /* ----------------------------------------------------------------------
         1. DEFAULT DATA & STORAGE KEYS
         ---------------------------------------------------------------------- */
      const STORAGE_KEYS = {
        GOALS: "nutrition_check_goals_v1",
        LOGS: "nutrition_check_logs_v1",
        CUSTOM_FOODS: "nutrition_check_custom_foods_v1"
      };

      const DEFAULT_GOALS = {
        calories: 2000,
        protein: 150,
        carbs: 225,
        fat: 65,
        fiber: 30,
        sugar: 50
      };

      const DEFAULT_FOODS = [
        { id: "f1", name: "Chicken Breast (Grilled)", serving: "100g", calories: 165, protein: 31, carbs: 0, fat: 3.6, fiber: 0, sugar: 0 },
        { id: "f2", name: "Rolled Oats (Dry)", serving: "1/2 cup (40g)", calories: 150, protein: 5, carbs: 27, fat: 3, fiber: 4, sugar: 1 },
        { id: "f3", name: "Large Egg (Whole)", serving: "1 large (50g)", calories: 72, protein: 6.3, carbs: 0.4, fat: 4.8, fiber: 0, sugar: 0.2 },
        { id: "f4", name: "Brown Rice (Cooked)", serving: "1 cup (195g)", calories: 216, protein: 5, carbs: 45, fat: 1.8, fiber: 3.5, sugar: 0.7 },
        { id: "f5", name: "Banana (Medium)", serving: "1 medium (118g)", calories: 105, protein: 1.3, carbs: 27, fat: 0.4, fiber: 3.1, sugar: 14.4 },
        { id: "f6", name: "Greek Yogurt (Plain, Nonfat)", serving: "1 cup (227g)", calories: 130, protein: 23, carbs: 9, fat: 0, fiber: 0, sugar: 7 },
        { id: "f7", name: "Avocado (Fresh)", serving: "1/2 fruit (75g)", calories: 120, protein: 1.5, carbs: 6, fat: 11, fiber: 5, sugar: 0.5 },
        { id: "f8", name: "Salmon Fillet (Baked)", serving: "100g", calories: 208, protein: 20, carbs: 0, fat: 13, fiber: 0, sugar: 0 },
        { id: "f9", name: "Almonds (Raw)", serving: "1 oz (28g)", calories: 164, protein: 6, carbs: 6, fat: 14, fiber: 3.5, sugar: 1.2 },
        { id: "f10", name: "Broccoli (Steamed)", serving: "1 cup (156g)", calories: 55, protein: 3.7, carbs: 11.2, fat: 0.6, fiber: 5.1, sugar: 2.2 },
        { id: "f11", name: "Whole Wheat Bread", serving: "1 slice (32g)", calories: 81, protein: 4, carbs: 13.8, fat: 1.1, fiber: 1.9, sugar: 1.4 },
        { id: "f12", name: "Peanut Butter (Natural)", serving: "2 tbsp (32g)", calories: 190, protein: 7, carbs: 7, fat: 16, fiber: 2, sugar: 2 },
        { id: "f13", name: "Apple (Medium)", serving: "1 medium (182g)", calories: 95, protein: 0.5, carbs: 25, fat: 0.3, fiber: 4.4, sugar: 19 },
        { id: "f14", name: "Sweet Potato (Baked)", serving: "1 medium (114g)", calories: 103, protein: 2.3, carbs: 24, fat: 0.2, fiber: 3.8, sugar: 7.4 },
        { id: "f15", name: "Olive Oil (Extra Virgin)", serving: "1 tbsp (14g)", calories: 119, protein: 0, carbs: 0, fat: 13.5, fiber: 0, sugar: 0 },
        { id: "f16", name: "Black Beans (Cooked)", serving: "1/2 cup (86g)", calories: 114, protein: 7.6, carbs: 20.4, fat: 0.5, fiber: 7.5, sugar: 0.3 },
        { id: "f17", name: "Whey Protein Isolate", serving: "1 scoop (30g)", calories: 120, protein: 25, carbs: 2, fat: 1, fiber: 0, sugar: 1 },
        { id: "f18", name: "Quinoa (Cooked)", serving: "1 cup (185g)", calories: 222, protein: 8.1, carbs: 39.4, fat: 3.6, fiber: 5.2, sugar: 1.6 }
      ];

      const MEAL_CATEGORIES = [
        { key: "Breakfast", icon: "🌅" },
        { key: "Lunch", icon: "🥗" },
        { key: "Dinner", icon: "🍽️" },
        { key: "Snacks", icon: "🍎" }
      ];

      /* ----------------------------------------------------------------------
         2. APPLICATION STATE
         ---------------------------------------------------------------------- */
      let state = {
        goals: loadFromStorage(STORAGE_KEYS.GOALS, { ...DEFAULT_GOALS }),
        logs: loadFromStorage(STORAGE_KEYS.LOGS, {
          Breakfast: [],
          Lunch: [],
          Dinner: [],
          Snacks: []
        }),
        customFoods: loadFromStorage(STORAGE_KEYS.CUSTOM_FOODS, []),
        selectedFoodId: "f1",
        searchQuery: ""
      };

      function loadFromStorage(key, fallback) {
        try {
          const raw = localStorage.getItem(key);
          return raw ? JSON.parse(raw) : fallback;
        } catch (err) {
          console.warn("LocalStorage read error:", err);
          return fallback;
        }
      }

      function saveToStorage(key, value) {
        try {
          localStorage.setItem(key, JSON.stringify(value));
        } catch (err) {
          console.warn("LocalStorage write error:", err);
        }
      }

      function getAllFoods() {
        return [...state.customFoods, ...DEFAULT_FOODS];
      }

      function getSelectedFood() {
        const all = getAllFoods();
        return all.find((f) => f.id === state.selectedFoodId) || all[0];
      }

      /* ----------------------------------------------------------------------
         3. DOM REFERENCES
         ---------------------------------------------------------------------- */
      const els = {
        currentDate: document.getElementById("current-date"),
        goalBadge: document.getElementById("goal-badge"),
        ringProgress: document.getElementById("calorie-ring-progress"),
        ringConsumed: document.getElementById("ring-consumed"),
        statGoal: document.getElementById("stat-goal"),
        statRemLabel: document.getElementById("stat-rem-label"),
        statRemaining: document.getElementById("stat-remaining"),
        macroPctSummary: document.getElementById("macro-pct-summary"),
        splitProtein: document.getElementById("split-protein"),
        splitCarbs: document.getElementById("split-carbs"),
        splitFat: document.getElementById("split-fat"),
        valProtein: document.getElementById("val-protein"),
        barProtein: document.getElementById("bar-protein"),
        valCarbs: document.getElementById("val-carbs"),
        barCarbs: document.getElementById("bar-carbs"),
        valFat: document.getElementById("val-fat"),
        barFat: document.getElementById("bar-fat"),
        valFiber: document.getElementById("val-fiber"),
        barFiber: document.getElementById("bar-fiber"),
        valSugar: document.getElementById("val-sugar"),
        barSugar: document.getElementById("bar-sugar"),

        tabDatabase: document.getElementById("tab-database"),
        tabCustom: document.getElementById("tab-custom"),
        panelDatabase: document.getElementById("panel-database"),
        panelCustom: document.getElementById("panel-custom"),

        foodSearch: document.getElementById("food-search"),
        foodList: document.getElementById("food-list"),
        selectedFoodName: document.getElementById("selected-food-name"),
        selectedFoodUnit: document.getElementById("selected-food-unit"),
        servingMultiplier: document.getElementById("serving-multiplier"),
        mealSelect: document.getElementById("meal-select"),
        servingPreview: document.getElementById("serving-preview"),
        addSelectedBtn: document.getElementById("add-selected-btn"),

        mealsContainer: document.getElementById("meals-container"),

        openGoalsBtn: document.getElementById("open-goals-btn"),
        closeGoalsBtn: document.getElementById("close-goals-btn"),
        cancelGoalsBtn: document.getElementById("cancel-goals-btn"),
        goalsModal: document.getElementById("goals-modal"),
        goalsForm: document.getElementById("goals-form"),

        resetDayBtn: document.getElementById("reset-day-btn"),
        confirmModal: document.getElementById("confirm-modal"),
        cancelConfirmBtn: document.getElementById("cancel-confirm-btn"),
        proceedConfirmBtn: document.getElementById("proceed-confirm-btn"),

        toast: document.getElementById("toast")
      };

      /* ----------------------------------------------------------------------
         4. HELPER UTILITIES
         ---------------------------------------------------------------------- */
      function round1(num) {
        return Math.round((num + Number.EPSILON) * 10) / 10;
      }

      let toastTimer = null;
      function showToast(message) {
        els.toast.textContent = message;
        els.toast.classList.add("show");
        clearTimeout(toastTimer);
        toastTimer = setTimeout(() => {
          els.toast.classList.remove("show");
        }, 2500);
      }

      function formatDate() {
        const now = new Date();
        return now.toLocaleDateString(undefined, {
          weekday: "short",
          month: "short",
          day: "numeric"
        });
      }

      /* ----------------------------------------------------------------------
         5. RENDER FUNCTIONS
         ---------------------------------------------------------------------- */
      function renderSummary() {
        const totals = { calories: 0, protein: 0, carbs: 0, fat: 0, fiber: 0, sugar: 0 };

        Object.values(state.logs).forEach((mealItems) => {
          mealItems.forEach((item) => {
            totals.calories += item.calories;
            totals.protein += item.protein;
            totals.carbs += item.carbs;
            totals.fat += item.fat;
            totals.fiber += item.fiber;
            totals.sugar += item.sugar;
          });
        });

        const goalCal = Math.max(1, state.goals.calories);
        const eatenCal = Math.round(totals.calories);
        const remainingCal = goalCal - eatenCal;

        // Header & Stat numbers
        els.goalBadge.textContent = `Goal: ${goalCal.toLocaleString()} kcal`;
        els.ringConsumed.textContent = eatenCal.toLocaleString();
        els.statGoal.textContent = `${goalCal.toLocaleString()} kcal`;

        if (remainingCal >= 0) {
          els.statRemLabel.textContent = "Remaining";
          els.statRemaining.textContent = `${remainingCal.toLocaleString()} kcal`;
          els.statRemaining.className = "stat-value positive";
        } else {
          els.statRemLabel.textContent = "Over Goal";
          els.statRemaining.textContent = `+${Math.abs(remainingCal).toLocaleString()} kcal`;
          els.statRemaining.className = "stat-value negative";
        }

        // SVG Progress Ring (Circumference = 2 * PI * 66 = 414.69)
        const circumference = 414.69;
        const ratio = Math.min(eatenCal / goalCal, 1);
        const offset = circumference - ratio * circumference;
        els.ringProgress.style.strokeDashoffset = offset.toFixed(2);
        if (eatenCal > goalCal) {
          els.ringProgress.classList.add("over-limit");
        } else {
          els.ringProgress.classList.remove("over-limit");
        }

        // Macro Caloric Split (Protein = 4 kcal/g, Carbs = 4 kcal/g, Fat = 9 kcal/g)
        const pCal = totals.protein * 4;
        const cCal = totals.carbs * 4;
        const fCal = totals.fat * 9;
        const macroCalSum = pCal + cCal + fCal;

        if (macroCalSum > 0) {
          const pPct = Math.round((pCal / macroCalSum) * 100);
          const cPct = Math.round((cCal / macroCalSum) * 100);
          const fPct = Math.max(0, 100 - pPct - cPct);
          els.splitProtein.style.width = `${pPct}%`;
          els.splitCarbs.style.width = `${cPct}%`;
          els.splitFat.style.width = `${fPct}%`;
          els.macroPctSummary.textContent = `${pPct}% P · ${cPct}% C · ${fPct}% F`;
        } else {
          els.splitProtein.style.width = "0%";
          els.splitCarbs.style.width = "0%";
          els.splitFat.style.width = "0%";
          els.macroPctSummary.textContent = "0% P · 0% C · 0% F";
        }

        // Individual Nutrient Progress Bars
        updateNutrientBar(els.valProtein, els.barProtein, totals.protein, state.goals.protein);
        updateNutrientBar(els.valCarbs, els.barCarbs, totals.carbs, state.goals.carbs);
        updateNutrientBar(els.valFat, els.barFat, totals.fat, state.goals.fat);
        updateNutrientBar(els.valFiber, els.barFiber, totals.fiber, state.goals.fiber);
        updateNutrientBar(els.valSugar, els.barSugar, totals.sugar, state.goals.sugar);
      }

      function updateNutrientBar(labelEl, fillEl, current, target) {
        const curRounded = round1(current);
        const safeTarget = Math.max(1, target);
        const pct = Math.min((curRounded / safeTarget) * 100, 100);
        labelEl.textContent = `${curRounded} / ${target} g`;
        fillEl.style.width = `${pct.toFixed(1)}%`;
      }

      function renderFoodList() {
        const q = state.searchQuery.trim().toLowerCase();
        const foods = getAllFoods().filter((f) => f.name.toLowerCase().includes(q));

        els.foodList.innerHTML = "";

        if (foods.length === 0) {
          const empty = document.createElement("div");
          empty.style.cssText = "padding:1rem; text-align:center; color:var(--text-muted); font-size:0.85rem;";
          empty.textContent = "No matching foods found. Try creating a Custom Food!";
          els.foodList.appendChild(empty);
          return;
        }

        foods.forEach((food) => {
          const btn = document.createElement("button");
          btn.type = "button";
          btn.className = "food-option" + (food.id === state.selectedFoodId ? " selected" : "");
          btn.innerHTML = `
            <div>
              <span class="food-opt-title">${escapeHtml(food.name)}${food.isCustom ? " ★" : ""}</span>
              <span class="food-opt-meta">${escapeHtml(food.serving)} · P ${food.protein}g · C ${food.carbs}g · F ${food.fat}g</span>
            </div>
            <span class="food-opt-cal">${food.calories} kcal</span>
          `;
          btn.addEventListener("click", () => {
            state.selectedFoodId = food.id;
            renderFoodList();
            renderServingPanel();
          });
          els.foodList.appendChild(btn);
        });
      }

      function renderServingPanel() {
        const food = getSelectedFood();
        if (!food) return;

        const mult = Math.max(0.1, parseFloat(els.servingMultiplier.value) || 1);
        els.selectedFoodName.textContent = food.name;
        els.selectedFoodUnit.textContent = `Base serving: ${food.serving}`;

        const cal = Math.round(food.calories * mult);
        const p = round1(food.protein * mult);
        const c = round1(food.carbs * mult);
        const f = round1(food.fat * mult);
        const fib = round1(food.fiber * mult);
        const sug = round1(food.sugar * mult);

        els.servingPreview.innerHTML = `
          <span class="pill" style="color:var(--primary-dark); border-color:var(--primary);">🔥 ${cal} kcal</span>
          <span class="pill">Protein: ${p}g</span>
          <span class="pill">Carbs: ${c}g</span>
          <span class="pill">Fat: ${f}g</span>
          <span class="pill">Fiber: ${fib}g</span>
          <span class="pill">Sugar: ${sug}g</span>
        `;
      }

      function renderMeals() {
        els.mealsContainer.innerHTML = "";

        MEAL_CATEGORIES.forEach(({ key, icon }) => {
          const items = state.logs[key] || [];
          const mealCalories = Math.round(items.reduce((sum, item) => sum + item.calories, 0));

          const card = document.createElement("div");
          card.className = "meal-card";

          const header = document.createElement("div");
          header.className = "meal-header";
          header.innerHTML = `
            <div class="meal-title-wrap">
              <span class="meal-icon" aria-hidden="true">${icon}</span>
              <h3 class="meal-name">${key}</h3>
            </div>
            <span class="meal-cals">${mealCalories.toLocaleString()} kcal</span>
          `;
          card.appendChild(header);

          const body = document.createElement("div");
          body.className = "meal-items";

          if (items.length === 0) {
            body.innerHTML = `<div class="meal-empty">No foods logged for ${key.toLowerCase()} yet.</div>`;
          } else {
            items.forEach((item) => {
              const row = document.createElement("div");
              row.className = "logged-item";
              row.innerHTML = `
                <div class="logged-info">
                  <div class="logged-name">${escapeHtml(item.name)} <span style="font-weight:400; color:var(--text-muted); font-size:0.82rem;">(${escapeHtml(item.servingLabel)})</span></div>
                  <div class="logged-macros">
                    P: ${item.protein}g · C: ${item.carbs}g · F: ${item.fat}g · Fiber: ${item.fiber}g · Sugar: ${item.sugar}g
                  </div>
                </div>
                <div class="logged-right">
                  <span class="logged-kcal">${Math.round(item.calories)} kcal</span>
                  <button type="button" class="btn-remove" title="Remove item" aria-label="Remove ${escapeHtml(item.name)}">✕</button>
                </div>
              `;
              row.querySelector(".btn-remove").addEventListener("click", () => {
                removeLoggedItem(key, item.logId);
              });
              body.appendChild(row);
            });
          }

          card.appendChild(body);
          els.mealsContainer.appendChild(card);
        });
      }

      function escapeHtml(str) {
        return String(str)
          .replace(/&/g, "&amp;")
          .replace(/</g, "&lt;")
          .replace(/>/g, "&gt;")
          .replace(/"/g, "&quot;");
      }

      /* ----------------------------------------------------------------------
         6. ACTIONS & MUTATIONS
         ---------------------------------------------------------------------- */
      function addFoodToMeal(mealName, entry) {
        if (!state.logs[mealName]) {
          state.logs[mealName] = [];
        }
        state.logs[mealName].push({
          logId: "log_" + Date.now() + "_" + Math.random().toString(36).slice(2, 6),
          ...entry
        });
        saveToStorage(STORAGE_KEYS.LOGS, state.logs);
        renderMeals();
        renderSummary();
        showToast(`Added ${entry.name} to ${mealName}`);
      }

      function removeLoggedItem(mealName, logId) {
        state.logs[mealName] = state.logs[mealName].filter((item) => item.logId !== logId);
        saveToStorage(STORAGE_KEYS.LOGS, state.logs);
        renderMeals();
        renderSummary();
        showToast("Item removed from log");
      }

      /* ----------------------------------------------------------------------
         7. EVENT LISTENERS
         ---------------------------------------------------------------------- */
      // Tab switching
      els.tabDatabase.addEventListener("click", () => {
        els.tabDatabase.classList.add("active");
        els.tabCustom.classList.remove("active");
        els.panelDatabase.classList.remove("hidden");
        els.panelCustom.classList.add("hidden");
      });

      els.tabCustom.addEventListener("click", () => {
        els.tabCustom.classList.add("active");
        els.tabDatabase.classList.remove("active");
        els.panelCustom.classList.remove("hidden");
        els.panelDatabase.classList.add("hidden");
      });

      // Food Search & Multiplier
      els.foodSearch.addEventListener("input", (e) => {
        state.searchQuery = e.target.value;
        renderFoodList();
      });

      els.servingMultiplier.addEventListener("input", renderServingPanel);

      // Add Selected Database Food
      els.addSelectedBtn.addEventListener("click", () => {
        const food = getSelectedFood();
        if (!food) return;

        const mult = Math.max(0.1, parseFloat(els.servingMultiplier.value) || 1);
        const meal = els.mealSelect.value;
        const servingLabel = mult === 1 ? food.serving : `${mult} × ${food.serving}`;

        addFoodToMeal(meal, {
          name: food.name,
          servingLabel,
          calories: round1(food.calories * mult),
          protein: round1(food.protein * mult),
          carbs: round1(food.carbs * mult),
          fat: round1(food.fat * mult),
          fiber: round1(food.fiber * mult),
          sugar: round1(food.sugar * mult)
        });
      });

      // Custom Food Form Submission
      els.panelCustom.addEventListener("submit", (e) => {
        e.preventDefault();
        const name = document.getElementById("custom-name").value.trim();
        const serving = document.getElementById("custom-serving-desc").value.trim() || "1 serving";
        const meal = document.getElementById("custom-meal").value;
        const calories = Math.max(0, parseFloat(document.getElementById("custom-calories").value) || 0);
        const protein = Math.max(0, parseFloat(document.getElementById("custom-protein").value) || 0);
        const carbs = Math.max(0, parseFloat(document.getElementById("custom-carbs").value) || 0);
        const fat = Math.max(0, parseFloat(document.getElementById("custom-fat").value) || 0);
        const fiber = Math.max(0, parseFloat(document.getElementById("custom-fiber").value) || 0);
        const sugar = Math.max(0, parseFloat(document.getElementById("custom-sugar").value) || 0);
        const saveToDb = document.getElementById("save-to-db").checked;

        if (!name) return;

        if (saveToDb) {
          const newFood = {
            id: "custom_" + Date.now(),
            name,
            serving,
            calories,
            protein,
            carbs,
            fat,
            fiber,
            sugar,
            isCustom: true
          };
          state.customFoods.unshift(newFood);
          saveToStorage(STORAGE_KEYS.CUSTOM_FOODS, state.customFoods);
          state.selectedFoodId = newFood.id;
          renderFoodList();
          renderServingPanel();
        }

        addFoodToMeal(meal, {
          name,
          servingLabel: serving,
          calories,
          protein,
          carbs,
          fat,
          fiber,
          sugar
        });

        els.panelCustom.reset();
        document.getElementById("custom-serving-desc").value = "1 serving";
        document.getElementById("save-to-db").checked = true;
      });

      // Goals Modal Controls
      function openGoalsModal() {
        document.getElementById("goal-calories").value = state.goals.calories;
        document.getElementById("goal-protein").value = state.goals.protein;
        document.getElementById("goal-carbs").value = state.goals.carbs;
        document.getElementById("goal-fat").value = state.goals.fat;
        document.getElementById("goal-fiber").value = state.goals.fiber;
        document.getElementById("goal-sugar").value = state.goals.sugar;
        els.goalsModal.classList.add("open");
      }

      function closeGoalsModal() {
        els.goalsModal.classList.remove("open");
      }

      els.openGoalsBtn.addEventListener("click", openGoalsModal);
      els.closeGoalsBtn.addEventListener("click", closeGoalsModal);
      els.cancelGoalsBtn.addEventListener("click", closeGoalsModal);
      els.goalsModal.addEventListener("click", (e) => {
        if (e.target === els.goalsModal) closeGoalsModal();
      });

      els.goalsForm.addEventListener("submit", (e) => {
        e.preventDefault();
        state.goals = {
          calories: Math.max(500, parseInt(document.getElementById("goal-calories").value, 10) || 2000),
          protein: Math.max(0, parseInt(document.getElementById("goal-protein").value, 10) || 150),
          carbs: Math.max(0, parseInt(document.getElementById("goal-carbs").value, 10) || 225),
          fat: Math.max(0, parseInt(document.getElementById("goal-fat").value, 10) || 65),
          fiber: Math.max(0, parseInt(document.getElementById("goal-fiber").value, 10) || 30),
          sugar: Math.max(0, parseInt(document.getElementById("goal-sugar").value, 10) || 50)
        };
        saveToStorage(STORAGE_KEYS.GOALS, state.goals);
        renderSummary();
        closeGoalsModal();
        showToast("Daily nutrition goals updated");
      });

      // Clear Day Confirmation Modal
      els.resetDayBtn.addEventListener("click", () => {
        els.confirmModal.classList.add("open");
      });

      els.cancelConfirmBtn.addEventListener("click", () => {
        els.confirmModal.classList.remove("open");
      });

      els.confirmModal.addEventListener("click", (e) => {
        if (e.target === els.confirmModal) els.confirmModal.classList.remove("open");
      });

      els.proceedConfirmBtn.addEventListener("click", () => {
        state.logs = { Breakfast: [], Lunch: [], Dinner: [], Snacks: [] };
        saveToStorage(STORAGE_KEYS.LOGS, state.logs);
        renderMeals();
        renderSummary();
        els.confirmModal.classList.remove("open");
        showToast("Daily meal log cleared");
      });

      /* ----------------------------------------------------------------------
         8. INITIALIZATION
         ---------------------------------------------------------------------- */
      function init() {
        els.currentDate.textContent = formatDate();
        renderFoodList();
        renderServingPanel();
        renderMeals();
        renderSummary();
      }

      init();
    })();
  </script>
</body>
</html>
