<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Nutrition Check — Daily Macro & Calorie Tracker</title>
  <style>
    /* ==========================================================================
       CSS VARIABLES & THEME TOKENS
       ========================================================================== */
    :root {
      --bg-app: #f4f7f6;
      --bg-card: #ffffff;
      --bg-subtle: #f8faf9;
      --bg-hover: #eef3f1;
      --text-main: #18231f;
      --text-muted: #5b6e67;
      --text-light: #879892;
      --border-color: #e2e9e6;
      --primary: #10b981;
      --primary-dark: #059669;
      --primary-light: #d1fae5;
      --accent-protein: #3b82f6;
      --accent-carbs: #f59e0b;
      --accent-fat: #ef4444;
      --accent-fiber: #8b5cf6;
      --accent-sugar: #ec4899;
      --shadow-sm: 0 1px 3px rgba(16, 35, 28, 0.05);
      --shadow-md: 0 6px 16px rgba(16, 35, 28, 0.08);
      --radius-sm: 8px;
      --radius-md: 14px;
      --radius-lg: 20px;
      --font-sans: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      --transition: all 0.2s cubic-bezier(0.25, 0.8, 0.25, 1);
    }

    @media (prefers-color-scheme: dark) {
      :root {
        --bg-app: #0e1513;
        --bg-card: #16201d;
        --bg-subtle: #1c2824;
        --bg-hover: #24332e;
        --text-main: #edf4f1;
        --text-muted: #9eb0a9;
        --text-light: #6d8079;
        --border-color: #263631;
        --primary: #10b981;
        --primary-dark: #34d399;
        --primary-light: rgba(16, 185, 129, 0.16);
        --shadow-sm: 0 2px 4px rgba(0, 0, 0, 0.25);
        --shadow-md: 0 8px 20px rgba(0, 0, 0, 0.35);
      }
    }

    /* ==========================================================================
       RESET & BASE STYLES
       ========================================================================== */
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: var(--font-sans);
      background-color: var(--bg-app);
      color: var(--text-main);
      line-height: 1.5;
      -webkit-font-smoothing: antialiased;
      min-height: 100vh;
    }

    button, input, select {
      font-family: inherit;
      font-size: 0.95rem;
      color: inherit;
    }

    button {
      cursor: pointer;
      border: none;
      background: none;
    }

    /* ==========================================================================
       HEADER & NAVIGATION
       ========================================================================== */
    header {
      background-color: var(--bg-card);
      border-bottom: 1px solid var(--border-color);
      position: sticky;
      top: 0;
      z-index: 50;
      box-shadow: var(--shadow-sm);
    }

    .header-inner {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0.9rem 1.25rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      flex-wrap: wrap;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 0.65rem;
    }

    .brand-icon {
      width: 38px;
      height: 38px;
      border-radius: 10px;
      background: linear-gradient(135deg, var(--primary), #047857);
      display: flex;
      align-items: center;
      justify-content: center;
      color: #fff;
      font-weight: 800;
      font-size: 1.15rem;
      box-shadow: 0 4px 10px rgba(16, 185, 129, 0.3);
    }

    .brand-title {
      font-size: 1.25rem;
      font-weight: 700;
      letter-spacing: -0.02em;
    }

    .brand-sub {
      font-size: 0.78rem;
      color: var(--text-muted);
      display: block;
    }

    .header-actions {
      display: flex;
      align-items: center;
      gap: 0.65rem;
    }

    .date-badge {
      background: var(--bg-subtle);
      border: 1px solid var(--border-color);
      padding: 0.45rem 0.85rem;
      border-radius: var(--radius-sm);
      font-size: 0.85rem;
      font-weight: 600;
      color: var(--text-muted);
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.45rem;
      padding: 0.55rem 1rem;
      border-radius: var(--radius-sm);
      font-weight: 600;
      font-size: 0.88rem;
      transition: var(--transition);
    }

    .btn-primary {
      background-color: var(--primary);
      color: #ffffff;
    }

    .btn-primary:hover {
      background-color: var(--primary-dark);
      transform: translateY(-1px);
    }

    .btn-outline {
      background-color: var(--bg-card);
      border: 1px solid var(--border-color);
      color: var(--text-main);
    }

    .btn-outline:hover {
      background-color: var(--bg-hover);
    }

    .btn-danger-soft {
      background-color: rgba(239, 68, 68, 0.1);
      color: #ef4444;
    }

    .btn-danger-soft:hover {
      background-color: rgba(239, 68, 68, 0.18);
    }

    /* ==========================================================================
       MAIN LAYOUT GRID
       ========================================================================== */
    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 1.5rem 1.25rem 3rem;
      display: grid;
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    @media (min-width: 960px) {
      .container {
        grid-template-columns: 420px 1fr;
        align-items: start;
      }
    }

    .card {
      background-color: var(--bg-card);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-md);
      padding: 1.35rem;
      box-shadow: var(--shadow-sm);
    }

    .card-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 1.15rem;
    }

    .card-title {
      font-size: 1.05rem;
      font-weight: 700;
      letter-spacing: -0.01em;
    }

    /* ==========================================================================
       DAILY SUMMARY & SVG CALORIE RING
       ========================================================================== */
    .summary-stack {
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }

    .calorie-hero {
      display: flex;
      align-items: center;
      justify-content: space-around;
      gap: 1.25rem;
      padding: 0.5rem 0;
      flex-wrap: wrap;
    }

    .ring-wrapper {
      position: relative;
      width: 168px;
      height: 168px;
      flex-shrink: 0;
    }

    .ring-svg {
      width: 100%;
      height: 100%;
      transform: rotate(-90deg);
    }

    .ring-bg {
      fill: none;
      stroke: var(--bg-hover);
      stroke-width: 14;
    }

    .ring-progress {
      fill: none;
      stroke: var(--primary);
      stroke-width: 14;
      stroke-linecap: round;
      transition: stroke-dashoffset 0.6s cubic-bezier(0.22, 1, 0.36, 1), stroke 0.3s ease;
    }

    .ring-progress.over-limit {
      stroke: var(--accent-fat);
    }

    .ring-center {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
    }

    .ring-kcal-val {
      font-size: 1.65rem;
      font-weight: 800;
      line-height: 1.1;
      letter-spacing: -0.02em;
    }

    .ring-kcal-label {
      font-size: 0.78rem;
      color: var(--text-muted);
      font-weight: 600;
      margin-top: 2px;
    }

    .calorie-stats {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      min-width: 140px;
    }

    .stat-row {
      display: flex;
      flex-direction: column;
    }

    .stat-label {
      font-size: 0.78rem;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.04em;
      font-weight: 600;
    }

    .stat-value {
      font-size: 1.15rem;
      font-weight: 700;
    }

    .stat-value.positive {
      color: var(--primary);
    }

    .stat-value.negative {
      color: var(--accent-fat);
    }

    /* ==========================================================================
       MACRO BREAKDOWN VISUALIZATION & PROGRESS BARS
       ========================================================================== */
    .macro-split-bar {
      height: 12px;
      width: 100%;
      background-color: var(--bg-hover);
      border-radius: 999px;
      overflow: hidden;
      display: flex;
      margin: 0.75rem 0 1.25rem;
    }

    .split-seg {
      height: 100%;
      transition: width 0.5s ease;
    }

    .seg-protein { background-color: var(--accent-protein); }
    .seg-carbs { background-color: var(--accent-carbs); }
    .seg-fat { background-color: var(--accent-fat); }

    .macro-legend {
      display: flex;
      justify-content: space-between;
      font-size: 0.78rem;
      color: var(--text-muted);
      margin-bottom: 1.15rem;
      padding-bottom: 0.9rem;
      border-bottom: 1px solid var(--border-color);
    }

    .legend-item {
      display: flex;
      align-items: center;
      gap: 0.35rem;
      font-weight: 600;
    }

    .dot {
      width: 9px;
      height: 9px;
      border-radius: 50%;
    }

    .nutrient-bars {
      display: flex;
      flex-direction: column;
      gap: 0.95rem;
    }

    .nutrient-item-head {
      display: flex;
      justify-content: space-between;
      font-size: 0.85rem;
      margin-bottom: 0.35rem;
    }

    .nutrient-name {
      font-weight: 600;
    }

    .nutrient-nums {
      color: var(--text-muted);
      font-variant-numeric: tabular-nums;
    }

    .progress-track {
      width: 100%;
      height: 8px;
      background-color: var(--bg-hover);
      border-radius: 999px;
      overflow: hidden;
    }

    .progress-fill {
      height: 100%;
      border-radius: 999px;
      transition: width 0.45s cubic-bezier(0.22, 1, 0.36, 1);
    }

    /* ==========================================================================
       FOOD SEARCH, CUSTOMIZER & CUSTOM FOOD CREATOR
       ========================================================================== */
    .food-finder {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .tabs {
      display: flex;
      background-color: var(--bg-subtle);
      padding: 4px;
      border-radius: var(--radius-sm);
      border: 1px solid var(--border-color);
    }

    .tab-btn {
      flex: 1;
      padding: 0.5rem;
      border-radius: 6px;
      font-size: 0.85rem;
      font-weight: 600;
      color: var(--text-muted);
      transition: var(--transition);
    }

    .tab-btn.active {
      background-color: var(--bg-card);
      color: var(--text-main);
      box-shadow: var(--shadow-sm);
    }

    .search-box {
      position: relative;
    }

    .input-field {
      width: 100%;
      padding: 0.65rem 0.9rem;
      border-radius: var(--radius-sm);
      border: 1px solid var(--border-color);
      background-color: var(--bg-subtle);
      transition: var(--transition);
    }

    .input-field:focus {
      outline: none;
      border-color: var(--primary);
      background-color: var(--bg-card);
      box-shadow: 0 0 0 3px var(--primary-light);
    }

    .food-list {
      max-height: 250px;
      overflow-y: auto;
      display: flex;
      flex-direction: column;
      gap: 0.45rem;
      padding-right: 2px;
    }

    .food-option {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0.65rem 0.85rem;
      border-radius: var(--radius-sm);
      border: 1px solid var(--border-color);
      background-color: var(--bg-subtle);
      cursor: pointer;
      transition: var(--transition);
      text-align: left;
    }

    .food-option:hover {
      border-color: var(--primary);
      background-color: var(--bg-hover);
    }

    .food-option.selected {
      border-color: var(--primary);
      background-color: var(--primary-light);
    }

    .food-opt-title {
      font-weight: 600;
      font-size: 0.9rem;
      display: block;
    }

    .food-opt-meta {
      font-size: 0.78rem;
      color: var(--text-muted);
    }

    .food-opt-cal {
      font-weight: 700;
      font-size: 0.88rem;
      color: var(--primary-dark);
      white-space: nowrap;
      margin-left: 0.5rem;
    }

    /* Selected Food Serving Panel */
    .serving-panel {
      background-color: var(--bg-subtle);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-sm);
      padding: 1rem;
      display: flex;
      flex-direction: column;
      gap: 0.85rem;
    }

    .serving-controls {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.75rem;
    }

    .form-group {
      display: flex;
      flex-direction: column;
      gap: 0.3rem;
    }

    .form-label {
      font-size: 0.78rem;
      font-weight: 600;
      color: var(--text-muted);
    }

    .preview-pills {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
    }

    .pill {
      font-size: 0.76rem;
      font-weight: 600;
      padding: 0.25rem 0.55rem;
      border-radius: 6px;
      background-color: var(--bg-card);
      border: 1px solid var(--border-color);
    }

    /* Custom Food Form Grid */
    .custom-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 0.75rem;
    }

    .custom-grid .full-span {
      grid-column: span 2;
    }

    /* ==========================================================================
       MEAL LOGS SECTION
       ========================================================================== */
    .meals-column {
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
    }

    .meal-card {
      background-color: var(--bg-card);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-md);
      overflow: hidden;
      box-shadow: var(--shadow-sm);
    }

    .meal-header {
      padding: 1rem 1.25rem;
      background-color: var(--bg-subtle);
      border-bottom: 1px solid var(--border-color);
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .meal-title-wrap {
      display: flex;
      align-items: center;
      gap: 0.6rem;
    }

    .meal-icon {
      font-size: 1.2rem;
    }

    .meal-name {
      font-weight: 700;
      font-size: 1rem;
    }

    .meal-cals {
      font-weight: 700;
      font-size: 0.9rem;
      color: var(--primary-dark);
      background-color: var(--primary-light);
      padding: 0.25rem 0.65rem;
      border-radius: 999px;
    }

    .meal-items {
      padding: 0.5rem 1.25rem;
    }

    .meal-empty {
      padding: 1.15rem 0;
      text-align: center;
      color: var(--text-light);
      font-size: 0.86rem;
    }

    .logged-item {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
      padding: 0.75rem 0;
      border-bottom: 1px solid var(--border-color);
    }

    .logged-item:last-child {
      border-bottom: none;
    }

    .logged-info {
      flex: 1;
      min-width: 0;
    }

    .logged-name {
      font-weight: 600;
      font-size: 0.92rem;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .logged-macros {
      font-size: 0.78rem;
      color: var(--text-muted);
      margin-top: 2px;
    }

    .logged-right {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }

    .logged-kcal {
      font-weight: 700;
      font-size: 0.9rem;
      white-space: nowrap;
    }

    .btn-remove {
      width: 28px;
      height: 28px;
      border-radius: 6px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--text-light);
      transition: var(--transition);
    }

    .btn-remove:hover {
      background-color: rgba(239, 68, 68, 0.12);
      color: #ef4444;
    }

    /* ==========================================================================
       MODAL (CUSTOMIZE DAILY GOALS)
       ========================================================================== */
    .modal-backdrop {
      position: fixed;
      inset: 0;
      background-color: rgba(10, 20, 16, 0.55);
      backdrop-filter: blur(3px);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1rem;
      z-index: 100;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.2s ease;
    }

    .modal-backdrop.open {
      opacity: 1;
      pointer-events: auto;
    }

    .modal-box {
      background-color: var(--bg-card);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-md);
      width: 100%;
      max-width: 440px;
      padding: 1.5rem;
      box-shadow: var(--shadow-md);
      transform: translateY(10px);
      transition: transform 0.2s ease;
    }

    .modal-backdrop.open .modal-box {
      transform: translateY(0);
    }

    .modal-footer {
      display: flex;
      justify-content: flex-end;
      gap: 0.65rem;
      margin-top: 1.25rem;
    }

    /* ==========================================================================
       TOAST NOTIFICATION
       ========================================================================== */
    .toast {
      position: fixed;
      bottom: 1.25rem;
      right: 1.25rem;
      background-color: var(--text-main);
      color: var(--bg-card);
      padding: 0.7rem 1.1rem;
      border-radius: var(--radius-sm);
      font-size: 0.86rem;
      font-weight: 600;
      box-shadow: var(--shadow-md);
      transform: translateY(120%);
      opacity: 0;
      transition: all 0.25s ease;
      z-index: 200;
    }

    .toast.show {
      transform: translateY(0);
      opacity: 1;
    }

    .hidden {
      display: none !important;
    }

    /* ==========================================================================
       API NINJAS INTEGRATION STYLES
       ========================================================================== */
    .api-key-card {
      background-color: var(--bg-subtle);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-sm);
      padding: 0.85rem;
      display: flex;
      flex-direction: column;
      gap: 0.55rem;
    }

    .api-key-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.5rem;
    }

    .status-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      font-size: 0.74rem;
      font-weight: 700;
      padding: 0.2rem 0.55rem;
      border-radius: 999px;
      background-color: var(--bg-card);
      border: 1px solid var(--border-color);
      color: var(--text-muted);
    }

    .status-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background-color: #f59e0b;
    }

    .status-dot.connected {
      background-color: var(--primary);
      box-shadow: 0 0 0 3px var(--primary-light);
    }

    .query-textarea {
      width: 100%;
      min-height: 76px;
      resize: vertical;
      padding: 0.65rem 0.85rem;
      border-radius: var(--radius-sm);
      border: 1px solid var(--border-color);
      background-color: var(--bg-subtle);
      font-family: inherit;
      font-size: 0.92rem;
      color: inherit;
      line-height: 1.45;
      transition: var(--transition);
    }

    .query-textarea:focus {
      outline: none;
      border-color: var(--primary);
      background-color: var(--bg-card);
      box-shadow: 0 0 0 3px var(--primary-light);
    }

    .example-chips {
      display: flex;
      flex-wrap: wrap;
      gap: 0.35rem;
    }

    .chip-btn {
      font-size: 0.74rem;
      padding: 0.25rem 0.55rem;
      border-radius: 999px;
      background-color: var(--bg-subtle);
      border: 1px solid var(--border-color);
      color: var(--text-muted);
      font-weight: 500;
      transition: var(--transition);
    }

    .chip-btn:hover {
      border-color: var(--primary);
      color: var(--primary-dark);
      background-color: var(--primary-light);
    }

    .spinner {
      width: 15px;
      height: 15px;
      border: 2px solid rgba(255, 255, 255, 0.35);
      border-top-color: #ffffff;
      border-radius: 50%;
      animation: spin 0.7s linear infinite;
      display: inline-block;
    }

    @keyframes spin {
      to { transform: rotate(360deg); }
    }

    .api-alert {
      padding: 0.7rem 0.85rem;
      border-radius: var(--radius-sm);
      font-size: 0.83rem;
      line-height: 1.4;
    }

    .api-alert.error {
      background-color: rgba(239, 68, 68, 0.1);
      border: 1px solid rgba(239, 68, 68, 0.3);
      color: #dc2626;
    }

    @media (prefers-color-scheme: dark) {
      .api-alert.error {
        color: #f87171;
      }
    }

    .api-alert.info {
      background-color: var(--primary-light);
      border: 1px solid rgba(16, 185, 129, 0.3);
      color: var(--text-main);
    }

    .api-results-wrap {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      margin-top: 0.25rem;
    }

    .api-results-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.5rem;
      padding-top: 0.65rem;
      border-top: 1px solid var(--border-color);
    }

    .api-item-card {
      background-color: var(--bg-subtle);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-sm);
      padding: 0.85rem;
      display: flex;
      flex-direction: column;
      gap: 0.6rem;
      transition: var(--transition);
    }

    .api-item-card:hover {
      border-color: var(--primary);
    }

    .api-item-top {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 0.5rem;
    }

    .api-item-title {
      font-weight: 700;
      font-size: 0.96rem;
      text-transform: capitalize;
    }

    .api-item-serving {
      font-size: 0.78rem;
      color: var(--text-muted);
    }

    .api-item-kcal {
      font-weight: 800;
      font-size: 0.92rem;
      color: var(--primary-dark);
      background-color: var(--primary-light);
      padding: 0.2rem 0.55rem;
      border-radius: 6px;
      white-space: nowrap;
    }

    .premium-badge {
      font-size: 0.72rem;
      font-weight: 600;
      color: #b45309;
      background-color: rgba(245, 158, 11, 0.16);
      padding: 0.18rem 0.45rem;
      border-radius: 5px;
    }

    .facts-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 0.4rem;
      background-color: var(--bg-card);
      border: 1px solid var(--border-color);
      border-radius: 6px;
      padding: 0.55rem;
      font-size: 0.76rem;
    }

    .fact-cell {
      display: flex;
      flex-direction: column;
    }

    .fact-lbl {
      color: var(--text-light);
      font-size: 0.7rem;
    }

    .fact-val {
      font-weight: 700;
      color: var(--text-main);
    }

    .api-item-footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.5rem;
      flex-wrap: wrap;
    }

    .qty-inline {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      font-size: 0.8rem;
      color: var(--text-muted);
      font-weight: 600;
    }

    .qty-inline input {
      width: 64px;
      padding: 0.32rem 0.45rem;
      border-radius: 6px;
      border: 1px solid var(--border-color);
      background-color: var(--bg-card);
      font-weight: 600;
    }

    .micro-summary-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 0.5rem;
      margin-top: 1rem;
      padding-top: 0.9rem;
      border-top: 1px solid var(--border-color);
    }

    .micro-box {
      background-color: var(--bg-subtle);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-sm);
      padding: 0.55rem 0.65rem;
      text-align: center;
    }

    .micro-box-label {
      display: block;
      font-size: 0.72rem;
      color: var(--text-muted);
      font-weight: 600;
    }

    .micro-box-val {
      display: block;
      font-size: 0.92rem;
      font-weight: 700;
      margin-top: 2px;
    }

    .input-group-row {
      display: flex;
      gap: 0.4rem;
    }
  </style>
</head>
<body>

  <!-- ========================================================================
       HEADER
       ======================================================================== -->
  <header>
    <div class="header-inner">
      <div class="brand">
        <div class="brand-icon" aria-hidden="true">NC</div>
        <div>
          <span class="brand-title">Nutrition Check</span>
          <span class="brand-sub">Daily Macro &amp; Calorie Tracker</span>
        </div>
      </div>
      <div class="header-actions">
        <span id="current-date" class="date-badge">Today</span>
        <button id="open-goals-btn" class="btn btn-outline" type="button">Edit Goals</button>
        <button id="reset-day-btn" class="btn btn-danger-soft" type="button">Clear Day</button>
      </div>
    </div>
  </header>

  <!-- ========================================================================
       MAIN CONTENT
       ======================================================================== -->
  <main class="container">
    <!-- LEFT COLUMN: DAILY TRACKER & FOOD INPUT -->
    <section class="summary-stack">
      <!-- Daily Progress Card -->
      <div class="card">
        <div class="card-header">
          <h2 class="card-title">Daily Nutrition Summary</h2>
          <span id="goal-badge" style="font-size: 0.8rem; color: var(--text-muted); font-weight: 600;">Goal: 2,000 kcal</span>
        </div>

        <!-- SVG Calorie Ring -->
        <div class="calorie-hero">
          <div class="ring-wrapper">
            <svg class="ring-svg" viewBox="0 0 160 160">
              <circle class="ring-bg" cx="80" cy="80" r="66"></circle>
              <circle id="calorie-ring-progress" class="ring-progress" cx="80" cy="80" r="66"
                stroke-dasharray="414.69" stroke-dashoffset="414.69"></circle>
            </svg>
            <div class="ring-center">
              <span id="ring-consumed" class="ring-kcal-val">0</span>
              <span class="ring-kcal-label">kcal eaten</span>
            </div>
          </div>

          <div class="calorie-stats">
            <div class="stat-row">
              <span class="stat-label">Daily Goal</span>
              <span id="stat-goal" class="stat-value">2,000 kcal</span>
            </div>
            <div class="stat-row">
              <span id="stat-rem-label" class="stat-label">Remaining</span>
              <span id="stat-remaining" class="stat-value positive">2,000 kcal</span>
            </div>
          </div>
        </div>

        <!-- Caloric Macro Split Bar -->
        <div>
          <div style="display:flex; justify-content:space-between; font-size:0.78rem; color:var(--text-muted); font-weight:600; margin-top:0.5rem;">
            <span>Macro Energy Split</span>
            <span id="macro-pct-summary">0% P · 0% C · 0% F</span>
          </div>
          <div class="macro-split-bar" title="Macro calorie distribution">
            <div id="split-protein" class="split-seg seg-protein" style="width: 0%;"></div>
            <div id="split-carbs" class="split-seg seg-carbs" style="width: 0%;"></div>
            <div id="split-fat" class="split-seg seg-fat" style="width: 0%;"></div>
          </div>
          <div class="macro-legend">
            <span class="legend-item"><span class="dot" style="background:var(--accent-protein)"></span>Protein</span>
            <span class="legend-item"><span class="dot" style="background:var(--accent-carbs)"></span>Carbs</span>
            <span class="legend-item"><span class="dot" style="background:var(--accent-fat)"></span>Fat</span>
          </div>
        </div>

        <!-- Detailed Nutrient Progress Bars -->
        <div class="nutrient-bars">
          <!-- Protein -->
          <div>
            <div class="nutrient-item-head">
              <span class="nutrient-name">Protein</span>
              <span id="val-protein" class="nutrient-nums">0 / 150 g</span>
            </div>
            <div class="progress-track">
              <div id="bar-protein" class="progress-fill" style="width:0%; background:var(--accent-protein);"></div>
            </div>
          </div>

          <!-- Carbs -->
          <div>
            <div class="nutrient-item-head">
              <span class="nutrient-name">Carbohydrates</span>
              <span id="val-carbs" class="nutrient-nums">0 / 225 g</span>
            </div>
            <div class="progress-track">
              <div id="bar-carbs" class="progress-fill" style="width:0%; background:var(--accent-carbs);"></div>
            </div>
          </div>

          <!-- Fat -->
          <div>
            <div class="nutrient-item-head">
              <span class="nutrient-name">Fat</span>
              <span id="val-fat" class="nutrient-nums">0 / 65 g</span>
            </div>
            <div class="progress-track">
              <div id="bar-fat" class="progress-fill" style="width:0%; background:var(--accent-fat);"></div>
            </div>
          </div>

          <!-- Fiber -->
          <div>
            <div class="nutrient-item-head">
              <span class="nutrient-name">Dietary Fiber</span>
              <span id="val-fiber" class="nutrient-nums">0 / 30 g</span>
            </div>
            <div class="progress-track">
              <div id="bar-fiber" class="progress-fill" style="width:0%; background:var(--accent-fiber);"></div>
            </div>
          </div>

          <!-- Sugar -->
          <div>
            <div class="nutrient-item-head">
              <span class="nutrient-name">Sugar</span>
              <span id="val-sugar" class="nutrient-nums">0 / 50 g</span>
            </div>
            <div class="progress-track">
              <div id="bar-sugar" class="progress-fill" style="width:0%; background:var(--accent-sugar);"></div>
            </div>
          </div>

          <!-- Sodium -->
          <div>
            <div class="nutrient-item-head">
              <span class="nutrient-name">Sodium</span>
              <span id="val-sodium" class="nutrient-nums">0 / 2,300 mg</span>
            </div>
            <div class="progress-track">
              <div id="bar-sodium" class="progress-fill" style="width:0%; background:#0ea5e9;"></div>
            </div>
          </div>
        </div>

        <!-- Additional Micronutrient Totals -->
        <div class="micro-summary-grid">
          <div class="micro-box">
            <span class="micro-box-label">Sat. Fat</span>
            <span id="val-sat-fat" class="micro-box-val">0 g</span>
          </div>
          <div class="micro-box">
            <span class="micro-box-label">Potassium</span>
            <span id="val-potassium" class="micro-box-val">0 mg</span>
          </div>
          <div class="micro-box">
            <span class="micro-box-label">Cholesterol</span>
            <span id="val-cholesterol" class="micro-box-val">0 mg</span>
          </div>
        </div>
      </div>

      <!-- Add Food Card -->
      <div class="card food-finder">
        <div class="card-header" style="margin-bottom:0.25rem;">
          <h2 class="card-title">Log Food</h2>
        </div>

        <div class="tabs" role="tablist">
          <button id="tab-api" class="tab-btn active" type="button" role="tab">API Ninjas Lookup</button>
          <button id="tab-database" class="tab-btn" type="button" role="tab">Saved Staples</button>
          <button id="tab-custom" class="tab-btn" type="button" role="tab">+ Custom</button>
        </div>

        <!-- TAB 0: API NINJAS NATURAL LANGUAGE NUTRITION SEARCH -->
        <div id="panel-api" style="display:flex; flex-direction:column; gap:0.85rem;">
          <!-- Prominent Direct X-Api-Key Input Card -->
          <div class="api-key-card">
            <div class="api-key-header">
              <label class="form-label" for="api-key-input" style="margin:0; color:var(--text-main);">API Ninjas <code>X-Api-Key</code></label>
              <span class="status-badge">
                <span id="api-status-dot" class="status-dot"></span>
                <span id="api-status-text">No key saved</span>
              </span>
            </div>
            <div class="input-group-row">
              <input
                id="api-key-input"
                class="input-field"
                type="password"
                placeholder="Paste your API Ninjas X-Api-Key..."
                autocomplete="off"
                spellcheck="false"
                style="padding:0.5rem 0.75rem; font-size:0.86rem;"
              />
              <button id="toggle-key-vis-btn" type="button" class="btn btn-outline" style="padding:0.45rem 0.65rem; font-size:0.8rem;">Show</button>
            </div>
            <div style="display:flex; align-items:center; justify-content:space-between; gap:0.5rem; flex-wrap:wrap;">
              <span style="font-size:0.74rem; color:var(--text-muted);">Stored locally in your browser only.</span>
              <div style="display:flex; gap:0.4rem;">
                <button id="clear-api-key-btn" type="button" class="btn btn-danger-soft" style="padding:0.35rem 0.65rem; font-size:0.78rem;">Clear</button>
                <button id="save-api-key-btn" type="button" class="btn btn-outline" style="padding:0.35rem 0.7rem; font-size:0.78rem;">Save to Browser</button>
              </div>
            </div>
          </div>

          <form id="api-search-form" style="display:flex; flex-direction:column; gap:0.65rem;">
            <div class="form-group">
              <label class="form-label" for="api-query-input">Describe your food or full meal</label>
              <textarea
                id="api-query-input"
                class="query-textarea"
                placeholder="e.g., 2 eggs, 1 slice whole wheat toast, and 1 cup black coffee"
                required
              ></textarea>
            </div>

            <div class="example-chips">
              <button type="button" class="chip-btn" data-query="2 eggs, 1 slice whole wheat toast, and 1 cup black coffee">Breakfast plate</button>
              <button type="button" class="chip-btn" data-query="150g grilled chicken breast, 1 cup brown rice, 1 cup steamed broccoli">Chicken &amp; rice</button>
              <button type="button" class="chip-btn" data-query="1 medium banana and 2 tbsp peanut butter">Banana &amp; PB</button>
            </div>

            <div class="form-group">
              <label class="form-label" for="api-meal-select">Target Meal</label>
              <select id="api-meal-select" class="input-field">
                <option value="Breakfast">Breakfast</option>
                <option value="Lunch">Lunch</option>
                <option value="Dinner">Dinner</option>
                <option value="Snacks">Snacks</option>
              </select>
            </div>

            <button id="api-submit-btn" type="submit" class="btn btn-primary" style="width:100%;">
              Search Nutrition
            </button>
          </form>

          <p style="font-size:0.75rem; color:var(--text-muted); line-height:1.4;">
            API Ninjas returns exact nutritional values matching the quantities in your query, along with tier-available fields from your plan.
          </p>

          <div id="api-feedback" class="api-alert hidden"></div>

          <div id="api-results-wrap" class="api-results-wrap hidden">
            <div class="api-results-header">
              <span id="api-results-count" style="font-size:0.82rem; font-weight:700; color:var(--text-muted);">0 items found</span>
              <button id="log-all-api-btn" type="button" class="btn btn-primary" style="padding:0.4rem 0.75rem; font-size:0.8rem;">
                Add All Items to Meal
              </button>
            </div>
            <div id="api-results-list" style="display:flex; flex-direction:column; gap:0.65rem;"></div>
          </div>
        </div>

        <!-- TAB 1: SEARCH & SELECT DATABASE FOOD -->
        <div id="panel-database" class="hidden" style="display:flex; flex-direction:column; gap:0.85rem;">
          <div class="search-box">
            <input id="food-search" class="input-field" type="text" placeholder="Search saved &amp; staple foods..." />
          </div>

          <div id="food-list" class="food-list" role="listbox" aria-label="Available foods"></div>

          <!-- Serving Customizer for Selected Food -->
          <div id="serving-panel" class="serving-panel">
            <div>
              <div style="font-size:0.75rem; color:var(--text-muted); font-weight:600;">SELECTED ITEM</div>
              <div id="selected-food-name" style="font-weight:700; font-size:0.98rem;">Chicken Breast (Grilled)</div>
              <div id="selected-food-unit" style="font-size:0.78rem; color:var(--text-muted);">Base serving: 100g</div>
            </div>

            <div class="serving-controls">
              <div class="form-group">
                <label class="form-label" for="serving-multiplier">Servings</label>
                <input id="serving-multiplier" class="input-field" type="number" min="0.1" max="50" step="0.1" value="1" />
              </div>
              <div class="form-group">
                <label class="form-label" for="meal-select">Meal</label>
                <select id="meal-select" class="input-field">
                  <option value="Breakfast">Breakfast</option>
                  <option value="Lunch">Lunch</option>
                  <option value="Dinner">Dinner</option>
                  <option value="Snacks">Snacks</option>
                </select>
              </div>
            </div>

            <div id="serving-preview" class="preview-pills"></div>

            <button id="add-selected-btn" class="btn btn-primary" type="button" style="width:100%;">
              + Add to Meal Log
            </button>
          </div>
        </div>

        <!-- TAB 2: ADD CUSTOM FOOD -->
        <form id="panel-custom" class="custom-grid hidden">
          <div class="form-group full-span">
            <label class="form-label" for="custom-name">Food Name *</label>
            <input id="custom-name" class="input-field" type="text" placeholder="e.g., Homemade Protein Smoothie" required />
          </div>

          <div class="form-group">
            <label class="form-label" for="custom-serving-desc">Serving Size *</label>
            <input id="custom-serving-desc" class="input-field" type="text" placeholder="e.g., 1 cup (240ml)" value="1 serving" required />
          </div>

          <div class="form-group">
            <label class="form-label" for="custom-meal">Add to Meal</label>
            <select id="custom-meal" class="input-field">
              <option value="Breakfast">Breakfast</option>
              <option value="Lunch">Lunch</option>
              <option value="Dinner">Dinner</option>
              <option value="Snacks">Snacks</option>
            </select>
          </div>

          <div class="form-group">
            <label class="form-label" for="custom-calories">Calories (kcal) *</label>
            <input id="custom-calories" class="input-field" type="number" min="0" step="1" placeholder="0" required />
          </div>

          <div class="form-group">
            <label class="form-label" for="custom-protein">Protein (g)</label>
            <input id="custom-protein" class="input-field" type="number" min="0" step="0.1" placeholder="0" />
          </div>

          <div class="form-group">
            <label class="form-label" for="custom-carbs">Carbs (g)</label>
            <input id="custom-carbs" class="input-field" type="number" min="0" step="0.1" placeholder="0" />
          </div>

          <div class="form-group">
            <label class="form-label" for="custom-fat">Fat (g)</label>
            <input id="custom-fat" class="input-field" type="number" min="0" step="0.1" placeholder="0" />
          </div>

          <div class="form-group">
            <label class="form-label" for="custom-fiber">Fiber (g)</label>
            <input id="custom-fiber" class="input-field" type="number" min="0" step="0.1" placeholder="0" />
          </div>

          <div class="form-group">
            <label class="form-label" for="custom-sugar">Sugar (g)</label>
            <input id="custom-sugar" class="input-field" type="number" min="0" step="0.1" placeholder="0" />
          </div>

          <div class="full-span" style="display:flex; align-items:center; gap:0.5rem; margin-top:0.2rem;">
            <input id="save-to-db" type="checkbox" checked style="width:16px; height:16px; accent-color:var(--primary);" />
            <label for="save-to-db" style="font-size:0.82rem; color:var(--text-muted); cursor:pointer;">
              Save food to my database for future reuse
            </label>
          </div>

          <div class="full-span">
            <button type="submit" class="btn btn-primary" style="width:100%;">Save &amp; Log Food</button>
          </div>
        </form>
      </div>
    </section>

    <!-- RIGHT COLUMN: DAILY MEAL LOGS -->
    <section class="meals-column" id="meals-container" aria-label="Daily Meal Logs">
      <!-- Rendered dynamically via JS -->
    </section>
  </main>

  <!-- ========================================================================
       EDIT DAILY GOALS MODAL
       ======================================================================== -->
  <div id="goals-modal" class="modal-backdrop" role="dialog" aria-modal="true" aria-labelledby="goals-modal-title">
    <div class="modal-box">
      <div class="card-header">
        <h3 id="goals-modal-title" class="card-title">Customize Daily Goals</h3>
        <button id="close-goals-btn" type="button" style="font-size:1.25rem; color:var(--text-muted);">&times;</button>
      </div>
      <form id="goals-form" class="custom-grid">
        <div class="form-group full-span">
          <label class="form-label" for="goal-calories">Daily Calorie Target (kcal)</label>
          <input id="goal-calories" class="input-field" type="number" min="500" max="10000" step="10" required />
        </div>
        <div class="form-group">
          <label class="form-label" for="goal-protein">Protein (g)</label>
          <input id="goal-protein" class="input-field" type="number" min="0" max="1000" step="1" required />
        </div>
        <div class="form-group">
          <label class="form-label" for="goal-carbs">Carbohydrates (g)</label>
          <input id="goal-carbs" class="input-field" type="number" min="0" max="1000" step="1" required />
        </div>
        <div class="form-group">
          <label class="form-label" for="goal-fat">Fat (g)</label>
          <input id="goal-fat" class="input-field" type="number" min="0" max="500" step="1" required />
        </div>
        <div class="form-group">
          <label class="form-label" for="goal-fiber">Dietary Fiber (g)</label>
          <input id="goal-fiber" class="input-field" type="number" min="0" max="200" step="1" required />
        </div>
        <div class="form-group">
          <label class="form-label" for="goal-sugar">Max Sugar Limit (g)</label>
          <input id="goal-sugar" class="input-field" type="number" min="0" max="500" step="1" required />
        </div>
        <div class="form-group">
          <label class="form-label" for="goal-sodium">Max Sodium Limit (mg)</label>
          <input id="goal-sodium" class="input-field" type="number" min="0" max="10000" step="50" required />
        </div>
        <div class="modal-footer full-span">
          <button id="cancel-goals-btn" type="button" class="btn btn-outline">Cancel</button>
          <button type="submit" class="btn btn-primary">Save Goals</button>
        </div>
      </form>
    </div>
  </div>

  <!-- ========================================================================
       CONFIRMATION MODAL (REPLACES window.confirm)
       ======================================================================== -->
  <div id="confirm-modal" class="modal-backdrop" role="dialog" aria-modal="true" aria-labelledby="confirm-title">
    <div class="modal-box" style="max-width:380px;">
      <h3 id="confirm-title" class="card-title" style="margin-bottom:0.5rem;">Clear Today's Log?</h3>
      <p style="font-size:0.9rem; color:var(--text-muted);">
        This will remove all logged food items across Breakfast, Lunch, Dinner, and Snacks. Your custom foods and goals will remain saved.
      </p>
      <div class="modal-footer">
        <button id="cancel-confirm-btn" type="button" class="btn btn-outline">Cancel</button>
        <button id="proceed-confirm-btn" type="button" class="btn btn-danger-soft" style="font-weight:700;">Clear Everything</button>
      </div>
    </div>
  </div>

  <!-- TOAST NOTIFICATION -->
  <div id="toast" class="toast" role="status" aria-live="polite"></div>

  <!-- ========================================================================
       VANILLA JAVASCRIPT APPLICATION LOGIC
       ======================================================================== -->
  <script>
    (function () {
      "use strict";

      /* ----------------------------------------------------------------------
         1. DEFAULT DATA & STORAGE KEYS
         ---------------------------------------------------------------------- */
      const STORAGE_KEYS = {
        GOALS: "nutrition_check_goals_v1",
        LOGS: "nutrition_check_logs_v1",
        CUSTOM_FOODS: "nutrition_check_custom_foods_v1",
        API_KEY: "nutrition_check_api_ninjas_key_v1"
      };

      const API_NINJAS_ENDPOINT = "https://api.api-ninjas.com/v1/nutrition";

      const DEFAULT_GOALS = {
