        carbs: 225,
        fat: 65,
        fiber: 30,
        sugar: 50,
        sodium: 2300
      };
// ... existing code ... -->
      let state = {
        goals: { ...DEFAULT_GOALS, ...loadFromStorage(STORAGE_KEYS.GOALS, {}) },
        logs: loadFromStorage(STORAGE_KEYS.LOGS, {
          Breakfast: [],
          Lunch: [],
          Dinner: [],
          Snacks: []
        }),
        customFoods: loadFromStorage(STORAGE_KEYS.CUSTOM_FOODS, []),
        apiKey: loadFromStorage(STORAGE_KEYS.API_KEY, ""),
        apiResults: [],
        selectedFoodId: "f1",
        searchQuery: ""
      };
// ... existing code ... -->
        valFiber: document.getElementById("val-fiber"),
        barFiber: document.getElementById("bar-fiber"),
        valSugar: document.getElementById("val-sugar"),
        barSugar: document.getElementById("bar-sugar"),
        valSodium: document.getElementById("val-sodium"),
        barSodium: document.getElementById("bar-sodium"),
        valSatFat: document.getElementById("val-sat-fat"),
        valPotassium: document.getElementById("val-potassium"),
        valCholesterol: document.getElementById("val-cholesterol"),

        tabApi: document.getElementById("tab-api"),
        tabDatabase: document.getElementById("tab-database"),
        tabCustom: document.getElementById("tab-custom"),
        panelApi: document.getElementById("panel-api"),
        panelDatabase: document.getElementById("panel-database"),
        panelCustom: document.getElementById("panel-custom"),

        apiStatusDot: document.getElementById("api-status-dot"),
        apiStatusText: document.getElementById("api-status-text"),
        apiKeyInput: document.getElementById("api-key-input"),
        toggleKeyVisBtn: document.getElementById("toggle-key-vis-btn"),
        saveApiKeyBtn: document.getElementById("save-api-key-btn"),
        clearApiKeyBtn: document.getElementById("clear-api-key-btn"),

