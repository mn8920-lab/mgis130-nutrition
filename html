      function parseApiNumeric(val) {
        if (typeof val === "number" && !Number.isNaN(val)) {
          return { value: val, isRestricted: false };
        }
        return {
          value: 0,
          isRestricted: true,
          notice: typeof val === "string" ? val : "Unavailable"
        };
      }

      function formatApiCell(info, mult, unit, isWhole = false) {
        if (info.isRestricted) {
          return `<span title="${escapeHtml(info.notice)}">—</span>`;
        }
        const scaled = info.value * mult;
        return `${isWhole ? Math.round(scaled) : round1(scaled)}${unit}`;
      }

      function updateApiKeyUI() {
        const savedKey = (state.apiKey || "").trim();
        if (els.apiKeyInput && document.activeElement !== els.apiKeyInput) {
          els.apiKeyInput.value = savedKey;
        }
        if (savedKey) {
          els.apiStatusDot.classList.add("connected");
          els.apiStatusText.textContent = "Key saved";
        } else {
          els.apiStatusDot.classList.remove("connected");
          els.apiStatusText.textContent = "No key saved";
        }
      }

      function setApiFeedback(message, type = "info") {
        if (!message) {
          els.apiFeedback.classList.add("hidden");
          els.apiFeedback.textContent = "";
          return;
        }
        els.apiFeedback.className = `api-alert ${type}`;
        els.apiFeedback.textContent = message;
        els.apiFeedback.classList.remove("hidden");
      }

      async function fetchNutritionFromApiNinjas(text) {
        const activeKey = (els.apiKeyInput.value || state.apiKey || "").trim();
        if (!activeKey) {
          els.apiKeyInput.focus();
          setApiFeedback("Please paste your API Ninjas X-Api-Key into the field above before searching.", "error");
          return;
        }

        // Keep state in sync if the user typed/pasted a key and immediately clicked Search
        if (activeKey !== state.apiKey) {
          state.apiKey = activeKey;
          saveToStorage(STORAGE_KEYS.API_KEY, state.apiKey);
          updateApiKeyUI();
        }

        const url = `${API_NINJAS_ENDPOINT}?query=${encodeURIComponent(text)}`;

        els.apiSubmitBtn.disabled = true;
        els.apiSubmitBtn.innerHTML = `<span class="spinner"></span> Searching...`;
        setApiFeedback(null);

        try {
          const response = await fetch(url, {
            method: "GET",
            headers: {
              "X-Api-Key": activeKey
            }
          });

          if (!response.ok) {
            let errDetail = "";
            try {
              const errJson = await response.json();
              errDetail = errJson.error || errJson.message || "";
            } catch (_) {
              errDetail = await response.text().catch(() => "");
            }

            if (response.status === 400 || response.status === 401 || response.status === 403) {
              throw new Error(`API Ninjas authentication failed (${response.status}). Please verify your X-Api-Key. ${errDetail}`);
            }
            throw new Error(`API Ninjas request failed (${response.status}). ${errDetail}`);
          }

          const data = await response.json();

          if (!Array.isArray(data) || data.length === 0) {
            state.apiResults = [];
            renderApiResults();
            setApiFeedback("No recognizable food items were returned for that query. Try including quantities like '150g chicken breast' or '2 eggs'.", "info");
            return;
          }

          state.apiResults = data.map((raw, idx) => ({
            ...raw,
            _uid: `api_${Date.now()}_${idx}`,
            _multiplier: 1
          }));

          renderApiResults();
        } catch (err) {
          console.error("API Ninjas Error:", err);
          setApiFeedback(err.message || "Network error while contacting API Ninjas.", "error");
        } finally {
          els.apiSubmitBtn.disabled = false;
          els.apiSubmitBtn.textContent = "Search Nutrition";
        }
      }

      function normalizeApiItemForLog(item) {
        const mult = Math.max(0.1, Number(item._multiplier) || 1);
        const cal = parseApiNumeric(item.calories).value * mult;
        const pro = parseApiNumeric(item.protein_g).value * mult;
        const carb = parseApiNumeric(item.carbohydrates_total_g).value * mult;
        const fat = parseApiNumeric(item.fat_total_g).value * mult;
        const fib = parseApiNumeric(item.fiber_g).value * mult;
        const sug = parseApiNumeric(item.sugar_g).value * mult;
        const satFat = parseApiNumeric(item.fat_saturated_g).value * mult;
        const sodium = parseApiNumeric(item.sodium_mg).value * mult;
        const potassium = parseApiNumeric(item.potassium_mg).value * mult;
        const cholesterol = parseApiNumeric(item.cholesterol_mg).value * mult;
        const servingG = parseApiNumeric(item.serving_size_g).value * mult;

        const baseServingText = servingG > 0 ? `${round1(servingG)}g` : `${mult} serving`;
        const titleCasedName = String(item.name || "Food Item")
          .split(" ")
          .map((w) => w.charAt(0).toUpperCase() + w.slice(1))
          .join(" ");

        return {
          name: titleCasedName,
          servingLabel: baseServingText,
          calories: round1(cal),
          protein: round1(pro),
          carbs: round1(carb),
          fat: round1(fat),
          fiber: round1(fib),
          sugar: round1(sug),
          satFat: round1(satFat),
          sodium: round1(sodium),
          potassium: round1(potassium),
          cholesterol: round1(cholesterol)
        };
      }

